<Project>
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">13</UmbracoMajor>
    <TargetFramework Condition="'$(UmbracoMajor)' == '13'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(UmbracoMajor)' != '13'">net10.0</TargetFramework>
    <Version>$(UmbracoMajor).0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);UMBRACO_$(UmbracoMajor)</DefineConstants>
  </PropertyGroup>
</Project>
